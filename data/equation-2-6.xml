<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msubsup><mi>x</mi><mi>i</mi><mo>*</mo></msubsup><mo>∈</mo><munder><mrow><mi>a</mi><mi>r</mi><mi>g</mi><mspace width="0.167em"></mspace><mi>m</mi><mi>i</mi><mi>n</mi></mrow><mrow><mi>x</mi><mo>∈</mo><msub><mi>Ω</mi><mi>i</mi></msub></mrow></munder><msub><mo>max</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi>S</mi><mi>i</mi></msub></mrow></msub><msubsup><mi>C</mi><mi>i</mi><mrow><mi>P</mi><mi>V</mi></mrow></msubsup><mrow><mo form="prefix" stretchy="true">(</mo><mi>x</mi><mo>,</mo><mi>s</mi><mo form="postfix" stretchy="true">)</mo></mrow></mrow><annotation encoding="application/x-tex">x_{i}^{\ast} \in \underset{x \in \Omega_{i}}{arg\, min}\max_{s \in S_{i}}C_{i}^{PV}(x,s)</annotation></semantics></math>
<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>Ω</mi><mi>i</mi></msub><mo>=</mo><mo form="prefix" stretchy="false">{</mo><mi>x</mi><mo>:</mo><msub><mi>g</mi><mi>m</mi></msub><mrow><mo form="prefix" stretchy="true">(</mo><mi>x</mi><mo>,</mo><mi>s</mi><mo form="postfix" stretchy="true">)</mo></mrow><mo>≤</mo><mn>0</mn><mspace width="0.222em"></mspace><mo>∀</mo><mi>m</mi><mo>,</mo><mi>s</mi><mo>;</mo><mspace width="0.222em"></mspace><msub><mi>R</mi><mrow><mi>r</mi><mi>t</mi></mrow></msub><mrow><mo form="prefix" stretchy="true">(</mo><mi>x</mi><mo>,</mo><mi>s</mi><mo form="postfix" stretchy="true">)</mo></mrow><mo>≤</mo><msub><mi>B</mi><mrow><mi>r</mi><mi>t</mi><mo>,</mo><mi>s</mi></mrow></msub><mspace width="0.222em"></mspace><mo>∀</mo><mi>r</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>s</mi><mo form="postfix" stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\Omega_{i} = \{ x:g_{m}(x,s) \leq 0\ \forall m,s;\ R_{rt}(x,s) \leq B_{rt,s}\ \forall r,t,s\}</annotation></semantics></math>
<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msubsup><mi>C</mi><mi>i</mi><mrow><mi>P</mi><mi>V</mi></mrow></msubsup><mrow><mo form="prefix" stretchy="true">(</mo><mi>x</mi><mo>,</mo><mi>s</mi><mo form="postfix" stretchy="true">)</mo></mrow><mo>=</mo><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></msubsup><mfrac><mrow><msubsup><mi>C</mi><mrow><mi>i</mi><mi>t</mi></mrow><mrow><mi>d</mi><mi>i</mi><mi>r</mi></mrow></msubsup><mo>+</mo><msubsup><mi>C</mi><mrow><mi>i</mi><mi>t</mi></mrow><mrow><mi>t</mi><mi>r</mi></mrow></msubsup><mo>+</mo><msubsup><mi>L</mi><mrow><mi>i</mi><mi>t</mi></mrow><mrow><mi>r</mi><mi>e</mi><mi>s</mi></mrow></msubsup></mrow><msup><mrow><mo form="prefix" stretchy="true">(</mo><mn>1</mn><mo>+</mo><mi>d</mi><mo form="postfix" stretchy="true">)</mo></mrow><mi>t</mi></msup></mfrac><mo>−</mo><mfrac><msub><mi>R</mi><mrow><mi>i</mi><mi>T</mi></mrow></msub><msup><mrow><mo form="prefix" stretchy="true">(</mo><mn>1</mn><mo>+</mo><mi>d</mi><mo form="postfix" stretchy="true">)</mo></mrow><mi>T</mi></msup></mfrac></mrow><annotation encoding="application/x-tex">C_{i}^{PV}(x,s) = \sum_{t = 0}^{T}\frac{C_{it}^{dir} + C_{it}^{tr} + L_{it}^{res}}{{(1 + d)}^{t}} - \frac{R_{iT}}{{(1 + d)}^{T}}</annotation></semantics></math>