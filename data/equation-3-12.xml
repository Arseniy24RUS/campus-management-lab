<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>r</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msubsup><mo>∑</mo><mrow><mo>ℓ</mo><mo>=</mo><mn>0</mn></mrow><mi>L</mi></msubsup><msub><mi>A</mi><mo>ℓ</mo></msub><msub><mi>r</mi><mrow><mi>t</mi><mo>−</mo><mo>ℓ</mo></mrow></msub><mo>+</mo><msub><mi>h</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mspace width="1.0em"></mspace><mspace width="1.0em"></mspace><msub><mi>A</mi><mo>ℓ</mo></msub><mo>=</mo><msup><mrow><mo form="prefix" stretchy="true">(</mo><msup><mi>W</mi><mrow><mo form="prefix" stretchy="true">(</mo><mo>ℓ</mo><mo form="postfix" stretchy="true">)</mo></mrow></msup><mo form="postfix" stretchy="true">)</mo></mrow><mi>𝖳</mi></msup></mrow><annotation encoding="application/x-tex">r_{t + 1} = \sum_{\ell = 0}^{L}A_{\ell}r_{t - \ell} + h_{t + 1},\quad\quad A_{\ell} = \left( W^{(\ell)} \right)^{\mathsf{T}}</annotation></semantics></math>