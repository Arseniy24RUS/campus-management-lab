<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msubsup><mrow><mi>C</mi><mi>R</mi><mi>P</mi><mi>S</mi></mrow><mi>k</mi><mtext mathvariant="normal">*</mtext></msubsup><mo>=</mo><mfrac><mn>1</mn><msub><mi>s</mi><mi>k</mi></msub></mfrac><msubsup><mo>∫</mo><mrow><mi>−</mi><mi>∞</mi></mrow><mi>∞</mi></msubsup><msup><mrow><mo form="prefix" stretchy="true">[</mo><msub><mi>F</mi><mi>k</mi></msub><mrow><mo form="prefix" stretchy="true">(</mo><mi>z</mi><mo form="postfix" stretchy="true">)</mo></mrow><mo>−</mo><mn>𝟏</mn><mo form="prefix" stretchy="false">{</mo><mi>z</mi><mo>≥</mo><msub><mi>z</mi><mi>k</mi></msub><mo form="postfix" stretchy="false">}</mo><mo form="postfix" stretchy="true">]</mo></mrow><mn>2</mn></msup><mspace width="0.167em"></mspace><mi>d</mi><mi>z</mi></mrow><annotation encoding="application/x-tex">{CRPS}_{k}^{\text{*}} = \frac{1}{s_{k}}\int_{- \infty}^{\infty}\left\lbrack F_{k}(z) - \mathbf{1}\{ z \geq z_{k}\} \right\rbrack^{2}\, dz</annotation></semantics></math>